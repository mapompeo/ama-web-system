<!-- Navbar mobile -->
<nav class="navbar d-lg-none fixed-top px-3" style="background:var(--sidebar-bg);height:56px;z-index:400">
  <a class="navbar-brand d-flex align-items-center gap-2 text-white text-decoration-none" href="/dashboard">
    <div class="sidebar-brand-icon" style="width:28px;height:28px;font-size:.8rem;border-radius:7px"><i class="bi bi-heart-fill"></i></div>
    <span style="font-size:.9rem;font-weight:700">AMA ONG</span>
  </a>
  <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
    <i class="bi bi-list fs-4"></i>
  </button>
</nav>

<!-- Offcanvas mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" style="width:var(--sidebar-w)">
  <div class="offcanvas-header" style="border-bottom:1px solid rgba(255,255,255,.06)">
    <a href="/dashboard" class="sidebar-brand p-0 border-0">
      <div class="sidebar-brand-icon"><i class="bi bi-heart-fill"></i></div>
      <div>
        <div class="sidebar-brand-text">AMA ONG</div>
        <div class="sidebar-brand-sub">Palmira Gobbi</div>
      </div>
    </a>
    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column p-0" style="background:var(--sidebar-bg)">
    <div class="sidebar-section flex-grow-1">
      <div class="sidebar-section-label">Menu</div>
      <ul class="nav flex-column">
        <li><a href="/dashboard"     class="nav-link <%= locals.title === 'Dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i>Dashboard</a></li>
        <li><a href="/volunteers"    class="nav-link <%= locals.title && locals.title.includes('Voluntári') ? 'active' : '' %>"><i class="bi bi-people"></i>Voluntários</a></li>
        <li><a href="/beneficiaries" class="nav-link <%= locals.title && locals.title.includes('Atendido') ? 'active' : '' %>"><i class="bi bi-person-heart"></i>Atendidos</a></li>
        <li><a href="/activities"    class="nav-link <%= locals.title && locals.title.includes('Atividade') ? 'active' : '' %>"><i class="bi bi-calendar-event"></i>Atividades</a></li>
      </ul>
    </div>
    <div class="sidebar-footer">
      <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
      <span class="sidebar-user-name"><%= user ? user.name : '' %></span>
      <a href="/auth/logout" class="sidebar-logout" title="Sair"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </div>
</div>

<!-- Sidebar desktop -->
<nav id="sidebar" class="d-none d-lg-flex">
  <a href="/dashboard" class="sidebar-brand">
    <div class="sidebar-brand-icon"><i class="bi bi-heart-fill"></i></div>
    <div>
      <div class="sidebar-brand-text">AMA ONG</div>
      <div class="sidebar-brand-sub">Palmira Gobbi</div>
    </div>
    <button class="sidebar-pin" id="sidebarPin" title="Fixar menu" type="button">
      <i class="bi bi-chevron-right" id="sidebarPinIcon"></i>
    </button>
  </a>

  <div class="sidebar-section">
    <span class="sidebar-section-label">Menu</span>
    <ul class="nav flex-column">
      <li><a href="/dashboard"     class="nav-link <%= locals.title === 'Dashboard' ? 'active' : '' %>" title="Dashboard"><i class="bi bi-speedometer2"></i>Dashboard</a></li>
      <li><a href="/volunteers"    class="nav-link <%= locals.title && locals.title.includes('Voluntári') ? 'active' : '' %>" title="Voluntários"><i class="bi bi-people"></i>Voluntários</a></li>
      <li><a href="/beneficiaries" class="nav-link <%= locals.title && locals.title.includes('Atendido') ? 'active' : '' %>" title="Atendidos"><i class="bi bi-person-heart"></i>Atendidos</a></li>
      <li><a href="/activities"    class="nav-link <%= locals.title && locals.title.includes('Atividade') ? 'active' : '' %>" title="Atividades"><i class="bi bi-calendar-event"></i>Atividades</a></li>
    </ul>
  </div>

  <div class="sidebar-footer">
    <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
    <span class="sidebar-user-name"><%= user ? user.name : '' %></span>
    <a href="/auth/logout" class="sidebar-logout" title="Sair"><i class="bi bi-box-arrow-right"></i></a>
  </div>
</nav>

<script>
  (function () {
    const STORAGE_KEY = 'ama-sidebar-pinned';
    const body        = document.body;
    const pinBtn      = document.getElementById('sidebarPin');
    const pinIcon     = document.getElementById('sidebarPinIcon');

    // Restaura estado salvo
    if (localStorage.getItem(STORAGE_KEY) === '1') {
      body.classList.add('sidebar-pinned');
    }

    function updateIcon() {
      const pinned = body.classList.contains('sidebar-pinned');
      if (!pinIcon) return;
      pinIcon.className = pinned ? 'bi bi-chevron-left' : 'bi bi-chevron-right';
      if (pinBtn) pinBtn.title = pinned ? 'Desafixar menu' : 'Fixar menu';
    }

    updateIcon();

    if (pinBtn) {
      pinBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const pinned = body.classList.toggle('sidebar-pinned');
        localStorage.setItem(STORAGE_KEY, pinned ? '1' : '0');
        updateIcon();
      });
    }
  })();
</script>
