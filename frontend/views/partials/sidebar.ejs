<!-- Navbar mobile (visível só em telas pequenas) -->
<nav class="navbar navbar-dark d-lg-none fixed-top px-3" style="background-color:var(--primary)">
  <a class="navbar-brand fw-bold" href="/dashboard">
    <i class="bi bi-heart-fill me-2"></i>AMA ONG
  </a>
  <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
    <span class="navbar-toggler-icon"></span>
  </button>
</nav>

<!-- Offcanvas menu mobile -->
<div class="offcanvas offcanvas-start text-white" tabindex="-1" id="mobileMenu" style="background-color:var(--primary);width:240px">
  <div class="offcanvas-header">
    <span class="fw-bold fs-6"><i class="bi bi-heart-fill me-2"></i>AMA ONG</span>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column p-3">
    <ul class="nav nav-pills flex-column mb-auto">
      <li class="nav-item">
        <a href="/dashboard" class="nav-link text-white <%= locals.title === 'Dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
      </li>
      <li>
        <a href="/volunteers" class="nav-link text-white <%= locals.title && locals.title.includes('Voluntário') ? 'active' : '' %>">
          <i class="bi bi-people me-2"></i>Voluntários
        </a>
      </li>
      <li>
        <a href="/beneficiaries" class="nav-link text-white <%= locals.title && locals.title.includes('Atendido') ? 'active' : '' %>">
          <i class="bi bi-person-heart me-2"></i>Atendidos
        </a>
      </li>
      <li>
        <a href="/activities" class="nav-link text-white <%= locals.title && locals.title.includes('Atividade') ? 'active' : '' %>">
          <i class="bi bi-calendar-event me-2"></i>Atividades
        </a>
      </li>
    </ul>
    <hr class="border-secondary" />
    <div class="d-flex align-items-center justify-content-between">
      <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i><%= user ? user.name : '' %></span>
      <a href="/auth/logout" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </div>
</div>

<!-- Sidebar desktop -->
<nav id="sidebar" class="d-none d-lg-flex flex-column p-3 text-white">
  <a href="/dashboard" class="d-flex align-items-center mb-4 text-white text-decoration-none">
    <i class="bi bi-heart-fill me-2 fs-4"></i>
    <span class="fs-5 fw-bold">AMA ONG</span>
  </a>
  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <a href="/dashboard" class="nav-link text-white <%= locals.title === 'Dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
      </a>
    </li>
    <li>
      <a href="/volunteers" class="nav-link text-white <%= locals.title && locals.title.includes('Voluntário') ? 'active' : '' %>">
        <i class="bi bi-people me-2"></i>Voluntários
      </a>
    </li>
    <li>
      <a href="/beneficiaries" class="nav-link text-white <%= locals.title && locals.title.includes('Atendido') ? 'active' : '' %>">
        <i class="bi bi-person-heart me-2"></i>Atendidos
      </a>
    </li>
    <li>
      <a href="/activities" class="nav-link text-white <%= locals.title && locals.title.includes('Atividade') ? 'active' : '' %>">
        <i class="bi bi-calendar-event me-2"></i>Atividades
      </a>
    </li>
  </ul>
  <hr class="border-secondary" />
  <div class="d-flex align-items-center justify-content-between">
    <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i><%= user ? user.name : '' %></span>
    <a href="/auth/logout" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i></a>
  </div>
</nav>
