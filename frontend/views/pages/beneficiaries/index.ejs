<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 layout-table p-3">

    <div class="d-flex align-items-center justify-content-between mb-2">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Atendidos</li>
          </ol>
        </nav>
        <h1 class="page-title mt-1">Atendidos</h1>
      </div>
      <a href="/beneficiaries/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Novo</a>
    </div>

    <%- include('../../partials/alerts') %>

    <div class="card table-card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="input-group input-group-sm" style="max-width:280px">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" id="tableSearch" class="form-control" placeholder="Buscar atendido..." />
        </div>
        <span class="text-muted" style="font-size:.78rem"><%= beneficiaries.length %> registros</span>
      </div>

      <div class="card-body">
        <% if (beneficiaries.length === 0) { %>
          <p class="text-muted p-4 mb-0">Nenhum atendido cadastrado ainda.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Nome</th>
                  <th>Responsável</th>
                  <th>Telefone</th>
                  <th>Endereço</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="tableBody">
                <% beneficiaries.forEach(b => { %>
                  <tr>
                    <td class="text-muted"><%= b.id %></td>
                    <td><strong><%= b.name %></strong></td>
                    <td><%= b.responsible_name || '—' %></td>
                    <td><%= b.phone || '—' %></td>
                    <td>
                      <% if (b.address) { %>
                        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(b.address) %>"
                           target="_blank" rel="noopener"
                           class="text-decoration-none text-body d-flex align-items-center gap-1"
                           title="Abrir no Google Maps">
                          <i class="bi bi-geo-alt-fill text-danger" style="font-size:.85rem;flex-shrink:0"></i>
                          <span style="font-size:.83rem"><%= b.address %></span>
                        </a>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td><span class="badge <%= b.status === 'ativo' ? 'bg-success' : 'bg-secondary' %>"><%= b.status %></span></td>
                    <td class="text-end">
                      <a href="/beneficiaries/<%= b.id %>/edit" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i></a>
                      <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#del<%= b.id %>"><i class="bi bi-trash"></i></button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="card-footer">
        <div id="tablePagination"></div>
      </div>
    </div>
  </main>

  <% beneficiaries.forEach(b => { %>
  <div class="modal fade" id="del<%= b.id %>" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar exclusão</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">Remover o atendido <strong><%= b.name %></strong>? Esta ação não pode ser desfeita.</div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <form action="/beneficiaries/<%= b.id %>?_method=DELETE" method="POST" class="d-inline">
            <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Remover</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <% }) %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/table-utils.js"></script>
</body>
</html>
