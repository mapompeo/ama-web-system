<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/activities">Atividades</a></li>
        <li class="breadcrumb-item active"><%= activity ? 'Editar' : 'Nova' %></li>
      </ol>
    </nav>

    <div class="page-header">
      <h1 class="page-title"><%= title %></h1>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card" style="max-width:700px">
      <div class="card-body p-4">
        <form action="<%= action %>" method="<%= method %>" class="needs-validation" novalidate>
          <div class="row g-3">

            <div class="col-12">
              <label class="form-label">Título da atividade *</label>
              <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                <input type="text" class="form-control" name="title"
                  value="<%= activity ? activity.title : '' %>"
                  placeholder="Ex: Distribuição de Cestas Básicas"
                  minlength="3" required />
                <div class="invalid-feedback">Informe o título da atividade (mínimo 3 caracteres).</div>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label">Descrição</label>
              <textarea class="form-control" name="description" rows="3"
                placeholder="Descreva os detalhes da atividade, público-alvo, materiais necessários..."><%= activity ? activity.description || '' : '' %></textarea>
            </div>

            <div class="col-md-6">
              <label class="form-label">Data *</label>
              <input type="date" class="form-control" name="activity_date"
                value="<%= activity && activity.activity_date ? new Date(activity.activity_date).toISOString().split('T')[0] : '' %>"
                min="2000-01-01" required />
              <div class="invalid-feedback">Informe uma data válida.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Local</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <input type="text" class="form-control" name="location" id="locationField"
                  value="<%= activity ? activity.location || '' : '' %>"
                  placeholder="Ex: Sede da AMA, Salão Comunitário..." />
                <a id="mapsBtn" href="#" target="_blank" rel="noopener"
                   class="btn btn-outline-secondary" title="Abrir no Google Maps"
                   style="<%= activity && activity.location ? '' : 'display:none' %>">
                  <i class="bi bi-map"></i>
                </a>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="agendada"  <%= activity && activity.status === 'agendada'  ? 'selected' : '' %>>Agendada</option>
                <option value="realizada" <%= activity && activity.status === 'realizada' ? 'selected' : '' %>>Realizada</option>
                <option value="cancelada" <%= activity && activity.status === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
              </select>
            </div>

          </div>
          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
            <a href="/activities" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    const loc  = document.getElementById('locationField');
    const mBtn = document.getElementById('mapsBtn');
    if (loc && mBtn) {
      function updateMaps() {
        const v = loc.value.trim();
        mBtn.style.display = v ? '' : 'none';
        mBtn.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(v + ', Blumenau, SC');
      }
      loc.addEventListener('input', updateMaps);
      updateMaps();
    }
  </script>
</body>
</html>
