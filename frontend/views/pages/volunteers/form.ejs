<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/volunteers">Voluntários</a></li>
        <li class="breadcrumb-item active"><%= volunteer ? 'Editar' : 'Novo' %></li>
      </ol>
    </nav>

    <div class="page-header">
      <h1 class="page-title"><%= title %></h1>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card" style="max-width:700px">
      <div class="card-body p-4">
        <form action="<%= action %>" method="<%= method %>" class="needs-validation" novalidate>
          <div class="row g-3">

            <div class="col-md-6">
              <label class="form-label">Nome completo *</label>
              <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" class="form-control" name="name"
                  value="<%= volunteer ? volunteer.name : '' %>"
                  placeholder="Ex: Maria Silva"
                  minlength="3" required />
                <div class="invalid-feedback">Informe o nome completo (mínimo 3 caracteres).</div>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">E-mail</label>
              <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" name="email"
                  value="<%= volunteer ? volunteer.email || '' : '' %>"
                  placeholder="exemplo@email.com" />
                <div class="invalid-feedback">Informe um e-mail válido.</div>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Telefone</label>
              <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                <input type="text" class="form-control" name="phone"
                  value="<%= volunteer ? volunteer.phone || '' : '' %>"
                  data-mask="phone" />
                <div class="invalid-feedback">Informe um telefone válido com DDD.</div>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">CPF</label>
              <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                <input type="text" class="form-control" name="cpf"
                  value="<%= volunteer ? volunteer.cpf || '' : '' %>"
                  data-mask="cpf" />
                <div class="invalid-feedback">CPF inválido.</div>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label">Endereço</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <input type="text" class="form-control" name="address" id="addressField"
                  value="<%= volunteer ? volunteer.address || '' : '' %>"
                  placeholder="Rua, número, bairro, cidade" />
                <a id="mapsBtn" href="#" target="_blank" rel="noopener"
                   class="btn btn-outline-secondary" title="Abrir no Google Maps"
                   style="<%= volunteer && volunteer.address ? '' : 'display:none' %>">
                  <i class="bi bi-map"></i>
                </a>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Data de entrada</label>
              <input type="date" class="form-control" name="join_date"
                value="<%= volunteer && volunteer.join_date ? new Date(volunteer.join_date).toISOString().split('T')[0] : '' %>"
                max="<%= new Date().toISOString().split('T')[0] %>" />
              <div class="invalid-feedback">Data inválida.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="ativo"   <%= volunteer && volunteer.status === 'ativo'   ? 'selected' : '' %>>Ativo</option>
                <option value="inativo" <%= volunteer && volunteer.status === 'inativo' ? 'selected' : '' %>>Inativo</option>
              </select>
            </div>

          </div>
          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
            <a href="/volunteers" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    const addr = document.getElementById('addressField');
    const mBtn = document.getElementById('mapsBtn');
    if (addr && mBtn) {
      function updateMaps() {
        const v = addr.value.trim();
        mBtn.style.display = v ? '' : 'none';
        mBtn.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(v);
      }
      addr.addEventListener('input', updateMaps);
      updateMaps();
    }
  </script>
</body>
</html>
