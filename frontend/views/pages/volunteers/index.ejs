<%- include('../../partials/head') %>
<body class="d-flex">
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none">Dashboard</a></li>
        <li class="breadcrumb-item active">Voluntários</li>
      </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-success"></i>Voluntários</h5>
      <a href="/volunteers/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Novo Voluntário
      </a>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3">
        <div class="input-group input-group-sm" style="max-width:320px">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" id="tableSearch" class="form-control" placeholder="Buscar voluntário..." />
        </div>
      </div>
      <div class="card-body p-0">
        <% if (volunteers.length === 0) { %>
          <p class="text-muted p-4 mb-0">Nenhum voluntário cadastrado ainda.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Entrada</th><th>Status</th><th></th>
                </tr>
              </thead>
              <tbody id="tableBody">
                <% volunteers.forEach(v => { %>
                  <tr>
                    <td class="text-muted"><%= v.id %></td>
                    <td><strong><%= v.name %></strong></td>
                    <td><%= v.email || '—' %></td>
                    <td><%= v.phone || '—' %></td>
                    <td><%= v.join_date ? new Date(v.join_date).toLocaleDateString('pt-BR') : '—' %></td>
                    <td><span class="badge <%= v.status === 'ativo' ? 'bg-success' : 'bg-secondary' %>"><%= v.status %></span></td>
                    <td class="text-end">
                      <a href="/volunteers/<%= v.id %>/edit" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i></a>
                      <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#del<%= v.id %>"><i class="bi bi-trash"></i></button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="card-footer bg-white border-0 py-2">
            <div id="tablePagination"></div>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Modais de exclusão (fora da tabela) -->
  <% volunteers.forEach(v => { %>
  <div class="modal fade" id="del<%= v.id %>" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar exclusão</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">Remover o voluntário <strong><%= v.name %></strong>? Esta ação não pode ser desfeita.</div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <form action="/volunteers/<%= v.id %>?_method=DELETE" method="POST" class="d-inline">
            <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Remover</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <% }) %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/table-utils.js"></script>
</body>
</html>
