<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="flex-grow-1">
    <div class="page-header">
      <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="text-muted mb-0" style="font-size:.82rem">Visão geral da AMA ONG</p>
      </div>
    </div>
    <%- include('../partials/alerts') %>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
          <div class="stat-icon green"><i class="bi bi-people-fill"></i></div>
          <div>
            <div class="stat-value"><%= stats.volunteers %></div>
            <div class="stat-label">Voluntários ativos</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
          <div class="stat-icon blue"><i class="bi bi-person-heart"></i></div>
          <div>
            <div class="stat-value"><%= stats.beneficiaries %></div>
            <div class="stat-label">Atendidos ativos</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
          <div class="stat-icon amber"><i class="bi bi-calendar-check"></i></div>
          <div>
            <div class="stat-value"><%= stats.upcoming %></div>
            <div class="stat-label">Atividades agendadas</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
          <div class="stat-icon purple"><i class="bi bi-bar-chart-fill"></i></div>
          <div>
            <div class="stat-value"><%= monthlyChart.reduce((a,b) => a+b, 0) %></div>
            <div class="stat-label">Atividades em <%= chartYear %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gráfico + Recentes -->
    <div class="row g-3">
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header d-flex align-items-center justify-content-between">
            <span><i class="bi bi-bar-chart me-2 text-success"></i>Atividades por mês</span>
            <span class="badge bg-success bg-opacity-10 text-success fw-semibold"><%= chartYear %></span>
          </div>
          <div class="card-body">
            <canvas id="activityChart" height="130"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header">
            <i class="bi bi-clock-history me-2 text-primary"></i>Atividades Recentes
          </div>
          <div class="card-body p-0">
            <% if (recentActivities.length === 0) { %>
              <p class="text-muted p-3 mb-0">Nenhuma atividade cadastrada.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% recentActivities.forEach(a => { %>
                  <li class="list-group-item border-0 px-4 py-3 d-flex justify-content-between align-items-center">
                    <div style="min-width:0">
                      <div class="fw-semibold text-truncate" style="font-size:.85rem;max-width:200px"><%= a.title %></div>
                      <div class="text-muted d-flex align-items-center gap-1" style="font-size:.75rem">
                        <i class="bi bi-geo-alt"></i><%= a.location || '—' %>
                      </div>
                    </div>
                    <span class="badge ms-2 flex-shrink-0
                      <%= a.status === 'realizada' ? 'bg-success' : a.status === 'cancelada' ? 'bg-danger' : 'bg-warning text-dark' %>">
                      <%= a.status %>
                    </span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script>
    new Chart(document.getElementById('activityChart'), {
      type: 'bar',
      data: {
        labels: ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],
        datasets: [{
          label: 'Atividades',
          data: <%- JSON.stringify(monthlyChart) %>,
          backgroundColor: 'rgba(22,163,74,.15)',
          borderColor:     'rgba(22,163,74,.9)',
          borderWidth: 2,
          borderRadius: 6,
          borderSkipped: false,
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1, color: '#94a3b8', font: { size: 11 } },
            grid: { color: '#f1f5f9' },
            border: { display: false }
          },
          x: {
            ticks: { color: '#94a3b8', font: { size: 11 } },
            grid: { display: false },
            border: { display: false }
          }
        }
      }
    });
  </script>
</body>
</html>
