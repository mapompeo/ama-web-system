<%- include('../partials/head') %>
<body class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <h5 class="fw-bold mb-4">Dashboard</h5>
    <%- include('../partials/alerts') %>

    <!-- Cards de estatísticas -->
    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle p-3 bg-success bg-opacity-10">
              <i class="bi bi-people-fill text-success fs-3"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold"><%= stats.volunteers %></div>
              <div class="text-muted small">Voluntários ativos</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle p-3 bg-primary bg-opacity-10">
              <i class="bi bi-person-heart text-primary fs-3"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold"><%= stats.beneficiaries %></div>
              <div class="text-muted small">Atendidos ativos</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle p-3 bg-warning bg-opacity-10">
              <i class="bi bi-calendar-check text-warning fs-3"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold"><%= stats.upcoming %></div>
              <div class="text-muted small">Atividades agendadas</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gráfico + Atividades recentes -->
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header bg-white fw-semibold">
            <i class="bi bi-bar-chart me-2 text-success"></i>Atividades por mês — <%= chartYear %>
          </div>
          <div class="card-body">
            <canvas id="activityChart" height="120"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header bg-white fw-semibold">
            <i class="bi bi-clock-history me-2 text-success"></i>Atividades Recentes
          </div>
          <div class="card-body p-0">
            <% if (recentActivities.length === 0) { %>
              <p class="text-muted p-3 mb-0">Nenhuma atividade cadastrada.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% recentActivities.forEach(a => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                      <div class="fw-semibold small"><%= a.title %></div>
                      <div class="text-muted" style="font-size:.78rem"><%= a.location || '—' %></div>
                    </div>
                    <span class="badge <%= a.status === 'realizada' ? 'bg-success' : a.status === 'cancelada' ? 'bg-danger' : 'bg-warning text-dark' %>">
                      <%= a.status %>
                    </span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script>
    new Chart(document.getElementById('activityChart'), {
      type: 'bar',
      data: {
        labels: ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],
        datasets: [{
          label: 'Atividades',
          data: <%- JSON.stringify(monthlyChart) %>,
          backgroundColor: 'rgba(46,125,50,0.7)',
          borderColor: 'rgba(46,125,50,1)',
          borderWidth: 1,
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
      }
    });
  </script>
</body>
</html>
