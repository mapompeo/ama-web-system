<%- include('../../partials/head') %>
<body class="d-flex">
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <div class="d-flex align-items-center mb-4 gap-2">
      <a href="/activities" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
      <h5 class="fw-bold mb-0"><%= title %></h5>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card border-0 shadow-sm" style="max-width:700px;">
      <div class="card-body">
        <form action="<%= action %>" method="<%= method %>">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-semibold">Título *</label>
              <input type="text" class="form-control" name="title" value="<%= activity ? activity.title : '' %>" required />
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Descrição</label>
              <textarea class="form-control" name="description" rows="3"><%= activity ? activity.description || '' : '' %></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Data *</label>
              <input type="date" class="form-control" name="activity_date"
                value="<%= activity && activity.activity_date ? new Date(activity.activity_date).toISOString().split('T')[0] : '' %>" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Local</label>
              <input type="text" class="form-control" name="location" value="<%= activity ? activity.location || '' : '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Status</label>
              <select class="form-select" name="status">
                <option value="agendada" <%= activity && activity.status === 'agendada' ? 'selected' : '' %>>Agendada</option>
                <option value="realizada" <%= activity && activity.status === 'realizada' ? 'selected' : '' %>>Realizada</option>
                <option value="cancelada" <%= activity && activity.status === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
              </select>
            </div>
          </div>
          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="/activities" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
