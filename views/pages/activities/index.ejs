<%- include('../../partials/head') %>
<body class="d-flex">
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2 text-warning"></i>Atividades</h5>
      <a href="/activities/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Nova Atividade
      </a>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% if (activities.length === 0) { %>
          <p class="text-muted p-4 mb-0">Nenhuma atividade cadastrada ainda.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Título</th>
                  <th>Data</th>
                  <th>Local</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% activities.forEach(a => { %>
                  <tr>
                    <td class="text-muted"><%= a.id %></td>
                    <td><strong><%= a.title %></strong></td>
                    <td><%= new Date(a.activity_date).toLocaleDateString('pt-BR') %></td>
                    <td><%= a.location || '—' %></td>
                    <td>
                      <span class="badge
                        <%= a.status === 'realizada' ? 'bg-success' : a.status === 'cancelada' ? 'bg-danger' : 'bg-warning text-dark' %>">
                        <%= a.status %>
                      </span>
                    </td>
                    <td class="text-end">
                      <a href="/activities/<%= a.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/activities/<%= a.id %>?_method=DELETE" method="POST" class="d-inline"
                        onsubmit="return confirm('Remover <%= a.title %>?')">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
