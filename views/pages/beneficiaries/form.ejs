<%- include('../../partials/head') %>
<body class="d-flex">
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <div class="d-flex align-items-center mb-4 gap-2">
      <a href="/beneficiaries" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
      <h5 class="fw-bold mb-0"><%= title %></h5>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card border-0 shadow-sm" style="max-width:700px;">
      <div class="card-body">
        <form action="<%= action %>" method="<%= method %>">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Nome *</label>
              <input type="text" class="form-control" name="name" value="<%= beneficiary ? beneficiary.name : '' %>" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">CPF</label>
              <input type="text" class="form-control" name="cpf" value="<%= beneficiary ? beneficiary.cpf || '' : '' %>" placeholder="000.000.000-00" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Data de nascimento</label>
              <input type="date" class="form-control" name="birth_date"
                value="<%= beneficiary && beneficiary.birth_date ? new Date(beneficiary.birth_date).toISOString().split('T')[0] : '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Telefone</label>
              <input type="text" class="form-control" name="phone" value="<%= beneficiary ? beneficiary.phone || '' : '' %>" placeholder="(47) 99999-9999" />
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Endereço</label>
              <input type="text" class="form-control" name="address" value="<%= beneficiary ? beneficiary.address || '' : '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Nome do responsável</label>
              <input type="text" class="form-control" name="responsible_name" value="<%= beneficiary ? beneficiary.responsible_name || '' : '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Status</label>
              <select class="form-select" name="status">
                <option value="ativo" <%= beneficiary && beneficiary.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
                <option value="inativo" <%= beneficiary && beneficiary.status === 'inativo' ? 'selected' : '' %>>Inativo</option>
              </select>
            </div>
          </div>
          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="/beneficiaries" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
