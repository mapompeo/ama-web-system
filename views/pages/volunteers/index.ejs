<%- include('../../partials/head') %>
<body class="d-flex">
  <%- include('../../partials/sidebar') %>
  <main class="flex-grow-1 p-4 bg-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-success"></i>Voluntários</h5>
      <a href="/volunteers/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Novo Voluntário
      </a>
    </div>
    <%- include('../../partials/alerts') %>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% if (volunteers.length === 0) { %>
          <p class="text-muted p-4 mb-0">Nenhum voluntário cadastrado ainda.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Nome</th>
                  <th>E-mail</th>
                  <th>Telefone</th>
                  <th>Entrada</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% volunteers.forEach(v => { %>
                  <tr>
                    <td class="text-muted"><%= v.id %></td>
                    <td><strong><%= v.name %></strong></td>
                    <td><%= v.email || '—' %></td>
                    <td><%= v.phone || '—' %></td>
                    <td><%= v.join_date ? new Date(v.join_date).toLocaleDateString('pt-BR') : '—' %></td>
                    <td>
                      <span class="badge <%= v.status === 'ativo' ? 'bg-success' : 'bg-secondary' %>">
                        <%= v.status %>
                      </span>
                    </td>
                    <td class="text-end">
                      <a href="/volunteers/<%= v.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/volunteers/<%= v.id %>?_method=DELETE" method="POST" class="d-inline"
                        onsubmit="return confirm('Remover <%= v.name %>?')">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
